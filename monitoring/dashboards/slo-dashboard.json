{
  "dashboard": {
    "title": "TARGET SLO Dashboard - Service Level Objectives",
    "uid": "slo-dashboard-001",
    "tags": ["sre", "slo", "sli"],
    "timezone": "browser",
    "refresh": "30s",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "row",
        "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
        "title": "METRICS Service Level Objectives (SLO)"
      },
      {
        "id": 2,
        "title": "TARGET Availability SLO (Target: 99.9%)",
        "type": "gauge",
        "gridPos": {"x": 0, "y": 1, "w": 8, "h": 6},
        "targets": [{
          "expr": "avg_over_time(up{job=\"kafka-broker\"}[30d]) * 100",
          "legendFormat": "Current",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 99,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {"value": 99, "color": "red"},
                {"value": 99.5, "color": "yellow"},
                {"value": 99.9, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true,
          "text": {
            "titleSize": 18,
            "valueSize": 40
          }
        }
      },
      {
        "id": 3,
        "title": "LIGHTNING Latency p99 SLO (Target: <500ms)",
        "type": "gauge",
        "gridPos": {"x": 8, "y": 1, "w": 8, "h": 6},
        "targets": [{
          "expr": "histogram_quantile(0.99, rate(container_cpu_usage_seconds_total{namespace=\"default\",pod=~\"spark-worker.*\"}[5m])) * 1000",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "min": 0,
            "max": 1000,
            "thresholds": {
              "steps": [
                {"value": 0, "color": "green"},
                {"value": 500, "color": "yellow"},
                {"value": 750, "color": "red"}
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true
        }
      },
      {
        "id": 4,
        "title": "MONEY Error Budget Remaining (30d)",
        "type": "stat",
        "gridPos": {"x": 16, "y": 1, "w": 8, "h": 6},
        "targets": [{
          "expr": "((0.999 - (1 - avg_over_time(up{job=\"kafka-broker\"}[30d]))) / 0.001) * 100",
          "refId": "A"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"value": 0, "color": "red"},
                {"value": 25, "color": "yellow"},
                {"value": 50, "color": "green"}
              ]
            }
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "textMode": "value_and_name"
        }
      },
      {
        "id": 10,
        "type": "row",
        "gridPos": {"x": 0, "y": 7, "w": 24, "h": 1},
        "title": "📈 SLI Trends (Service Level Indicators)"
      },
      {
        "id": 11,
        "title": "Availability Trend (7 days)",
        "type": "timeseries",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "avg_over_time(up{job=\"kafka-broker\"}[1h]) * 100",
            "legendFormat": "Kafka",
            "refId": "A"
          },
          {
            "expr": "avg_over_time(up{job=\"spark-worker\"}[1h]) * 100",
            "legendFormat": "Spark",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "min": 99,
            "max": 100,
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 10
            }
          }
        },
        "options": {
          "tooltip": {"mode": "multi"},
          "legend": {"displayMode": "table", "placement": "bottom"}
        }
      },
      {
        "id": 12,
        "title": "Throughput vs Target (1000 msg/s)",
        "type": "timeseries",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(kafka_server_brokertopicmetrics_messagesin_total[1m])",
            "legendFormat": "Current Throughput",
            "refId": "A"
          },
          {
            "expr": "vector(1000)",
            "legendFormat": "SLO Target",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "msg/s",
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2
            }
          },
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "SLO Target"},
              "properties": [
                {"id": "custom.lineStyle", "value": {"dash": [10, 5], "fill": "dash"}},
                {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}}
              ]
            }
          ]
        }
      },
      {
        "id": 20,
        "type": "row",
        "gridPos": {"x": 0, "y": 16, "w": 24, "h": 1},
        "title": "🔍 SLO Compliance Summary"
      },
      {
        "id": 21,
        "title": "SLO Compliance (Last 30 days)",
        "type": "table",
        "gridPos": {"x": 0, "y": 17, "w": 24, "h": 8},
        "targets": [
          {
            "expr": "avg_over_time(up{job=\"kafka-broker\"}[30d]) * 100",
            "format": "table",
            "instant": true,
            "refId": "A"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "Value": "Current (%)"
              }
            }
          }
        ],
        "options": {
          "showHeader": true
        }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  }
}
